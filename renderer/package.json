{
	"name": "retween-renderer",
	"private": true,
	"type": "module",
	"description": "Timeline JSON -> MP4 renderer (Remotion) behind a small HTTP server.",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"build": "npm run build:bundle && npm run build:server",
		"build:bundle": "node scripts/bundle.mjs",
		"build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.mjs",
		"start": "node dist/server.mjs",
		"dev": "node --watch server/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --test server/",
		"fixtures": "node fixtures/make-media.mjs",
		"fixtures:serve": "node fixtures/serve.mjs",
		"studio": "node scripts/copy-public.mjs && remotion studio src/index.ts"
	},
	"dependencies": {
		"@remotion/lottie": "4.0.544",
		"@remotion/renderer": "4.0.544",
		"lottie-web": "5.13.0",
		"maplibre-gl": "6.16.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"remotion": "4.0.544",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@remotion/bundler": "4.0.544",
		"@remotion/media": "4.0.544",
		"@types/node": "^24.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"esbuild": "^0.28.2",
		"typescript": "^5.9.3"
	}
}
